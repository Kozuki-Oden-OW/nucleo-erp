            "type": "string",
            "description": "«tipo-folio», ej. 33-1, o el id interno"
          },
          "description": "Documentos a enviar"
        }
      },
      "required": [
        "documentos"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "consultar_estado_sii",
    "nivel": "ver",
    "description": "Pregunta al SII el estado del envío de un documento ya enviado (por su track id) y lo actualiza en NÚCLEO: aceptado, con reparos o rechazado, con la glosa del SII.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "documento": {
          "type": "string",
          "description": "«tipo-folio», ej. 33-1, o el id interno"
        }
      },
      "required": [
        "documento"
      ],
      "additionalProperties": false
    }
  }
]
