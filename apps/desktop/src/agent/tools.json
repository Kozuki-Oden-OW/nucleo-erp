            "efectivo",
            "transferencia",
            "tarjeta"
          ]
        },
        "notas": {
          "type": "string"
        }
      },
      "required": [
        "descripcion",
        "total",
        "categoria"
      ],
      "additionalProperties": false
    }
  },
  {
