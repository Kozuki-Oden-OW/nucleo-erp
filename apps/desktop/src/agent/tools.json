        },
        "comuna": {
          "type": "string"
        },
        "ciudad": {
          "type": "string"
        },
        "calle": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "depto": {
          "type": "string"
        },
        "referencia": {
          "type": "string"
        },
        "tipo_entrega": {
          "type": "string",
          "enum": [
            "domicilio",
