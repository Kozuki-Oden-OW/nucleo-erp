  {
    "name": "crear_venta_borrador",
    "nivel": "borradores",
    "description": "Crea una venta en borrador (no mueve stock ni dinero hasta confirmarla). Cada línea indica un producto por SKU o nombre, o una descripción libre con precio. precio_neto es por unidad, sin IVA; si se omite se usa el precio del producto. descuento en %.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cliente": {
          "type": "string",
          "description": "Nombre o RUT de un cliente existente (opcional)"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "VEN",
            "FV"
          ],
          "default": "VEN",
          "description": "VEN = venta con boleta, FV = factura"
        },
        "fecha": {
          "type": "string",
          "description": "AAAA-MM-DD; vacío = hoy"
        },
        "lineas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "producto": {
                "type": "string",
                "description": "SKU o nombre del producto"
              },
              "descripcion": {
                "type": "string"
              },
              "cantidad": {
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 1
              },
              "precio_neto": {
                "type": "number",
                "minimum": 0
              },
              "descuento": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "afecto_iva": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "notas": {
          "type": "string"
        }
      },
      "required": [
        "lineas"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "registrar_gasto",
    "nivel": "borradores",
    "description": "Registra un gasto. total en pesos; con_iva indica si el total incluye IVA recuperable. Sin acceso completo queda por pagar; con acceso completo se puede indicar medio de pago (efectivo, transferencia, tarjeta) para marcarlo pagado.",
