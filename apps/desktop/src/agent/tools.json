                "type": "string"
              },
              "giro": {
                "type": "string"
              },
              "notas": {
                "type": "string",
                "description": "Se agrega a las notas de la ficha (otros contactos, origen del dato…)"
              }
            },
            "required": [
              "nombre"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "clientes"
      ],
      "additionalProperties": false
    }
  },
